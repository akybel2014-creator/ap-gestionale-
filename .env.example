# Environment Variables for AI App Builder

# Public canonical base URL (optional; defaults to incoming request host or shared preview URL)
APP_URL=

# Mandatory Administrator Passphrase for /admin access (minimum 8 characters)
# Default or empty passwords ("admin" or "") are strictly rejected. If left unset, /admin login is disabled.
ADMIN_PASSWORD=

# Optional OpenWeatherMap API Key for server-side weather proxy (/api/weather/*)
OPENWEATHERMAP_API_KEY=

